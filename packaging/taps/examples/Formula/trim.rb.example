# Example Homebrew formula shape after GoReleaser publishes to usetrim/homebrew-tap.
# Do not commit a live formula here. Create github.com/usetrim/homebrew-tap and set
# HOMEBREW_TAP_TOKEN; GoReleaser writes Formula/trim.rb on each v* tag.
#
# Users: brew install usetrim/tap/trim

class Trim < Formula
  desc "AST-aware local LLM context optimization proxy"
  homepage "https://use-trim.com"
  # url / sha256 filled by GoReleaser from GitHub Release assets
  license "MIT"

  def install
    bin.install "trim"
    bin.install "optimizer.py" if File.exist?("optimizer.py")
    # requirements must sit beside optimizer.py for `trim compress --bootstrap`
    bin.install "requirements-deep.txt" if File.exist?("requirements-deep.txt")
    bin.install "requirements.txt" if File.exist?("requirements.txt")
  end

  def caveats
    <<~EOS
      Deep Mode uses Microsoft LLMLingua on this Mac only (not Trim cloud).
      Package install does not pip-install llmlingua.
      Once per machine:
        trim compress --bootstrap
      Success prints a green banner; then:
        trim compress <file> --deep
        trim start
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/trim version")
  end
end
