# Trim Operator Console (apps/admin)
# Deploy separately (e.g. https://admin.use-trim.com). Same Supabase project + Go API.
# Production: NEXT_PUBLIC_APP_URL=https://admin.use-trim.com
# Production: NEXT_PUBLIC_API_URL=https://api.use-trim.com

NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional CDN/static asset host for Next assetPrefix. Empty = relative (no invent).
# NEXT_PUBLIC_ASSET_PREFIX=https://cdn.example.com
NEXT_PUBLIC_API_URL_MISSING=NEXT_PUBLIC_API_URL is not set
NEXT_PUBLIC_SUPABASE_ENV_MISSING=NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are required
NEXT_PUBLIC_ENV_MISSING_FMT=Missing required environment variable: %s
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_ALLOWED_AUTH_PROVIDERS=google,github,gitlab

NEXT_PUBLIC_APP_PATH_LOGIN=/login
NEXT_PUBLIC_APP_PATH_AUTH_CALLBACK=/auth/callback
NEXT_PUBLIC_APP_PATH_HOME=/

# Comma-separated prefixes that require a signed-in session (no invent list in code).
NEXT_PUBLIC_ADMIN_PROTECTED_PREFIXES=/,/users,/segments,/rbac,/billing,/enterprise,/denylist,/product,/auth,/chrome,/observability,/distribution,/audit,/compliance,/break-glass
# Note: /auth protects Admin auth settings; /auth/callback is excluded in middleware.
