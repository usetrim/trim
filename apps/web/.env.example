# Frontend (Vercel / Cloudflare Pages)
# No plan prices here. Prices, annual % savings badge, and Paddle price IDs
# live in Supabase: plan_catalog + billing_settings (backend driven only).

# Local defaults. Production (use-trim.com):
# NEXT_PUBLIC_APP_URL=https://use-trim.com
# NEXT_PUBLIC_API_URL=https://api.use-trim.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional CDN/static asset host for Next assetPrefix. Empty = relative (no invent).
# NEXT_PUBLIC_ASSET_PREFIX=https://cdn.example.com
# Fail-closed message when NEXT_PUBLIC_API_URL is unset (no invent in use-api / cli-auth).
NEXT_PUBLIC_API_URL_MISSING=NEXT_PUBLIC_API_URL is not set
# Fail-closed when Supabase public URL/anon key are unset (client + server).
NEXT_PUBLIC_SUPABASE_ENV_MISSING=NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are required
# Fail-closed money helpers (currency_code + money_locale come from API; these are env miss only).
NEXT_PUBLIC_MONEY_CURRENCY_MISSING=currency_code missing from API
NEXT_PUBLIC_MONEY_LOCALE_MISSING=money_locale missing from API
NEXT_PUBLIC_ENV_MISSING_FMT=Missing required environment variable: %s
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Auth providers SSR/env fallback (comma-separated). Keep aligned with server
# ALLOWED_AUTH_PROVIDERS. Live /login and OAuth callback load the allow-list from
# GET /api/v1/public/auth-providers (public.auth_settings via the Go API).
# Enable Google, GitHub, and GitLab in Supabase Auth. GitHub scopes come from
# site_messages AUTH_GITHUB_OAUTH_SCOPES (read:user user:email). GitLab scopes
# come from AUTH_GITLAB_OAUTH_SCOPES (read_user). Turn on Automatic linking so
# the same verified email does not create a second account. Settings lists
# auth.identities and can Connect / Disconnect extra Google, GitHub, or GitLab.
NEXT_PUBLIC_ALLOWED_AUTH_PROVIDERS=google,github,gitlab

# App paths for Edge middleware auth gate (must match site_messages APP_PATH_*).
# Middleware cannot call the API on every request; keep these in sync with DB seeds.
NEXT_PUBLIC_APP_PATH_LOGIN=/login
NEXT_PUBLIC_APP_PATH_AUTH_CALLBACK=/auth/callback
NEXT_PUBLIC_APP_PATH_HOME=/
NEXT_PUBLIC_APP_PATH_DASHBOARD=/dashboard
NEXT_PUBLIC_APP_PATH_TEAM=/dashboard/team
NEXT_PUBLIC_APP_PATH_SETTINGS=/dashboard/settings
NEXT_PUBLIC_APP_PATH_RECEIPTS_PREFIX=/dashboard/receipts/

# Paddle.js client token only (never the API key)
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
