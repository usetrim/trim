# Trim CLI / local proxy
# Copy to project .env before running trim start / trim login
# Every required value must be set (no silent defaults).

TRIM_PORT=8888
UPSTREAM_OPENAI_URL=https://api.openai.com
UPSTREAM_ANTHROPIC_URL=https://api.anthropic.com
# Optional same-shape failover bases (empty disables)
# UPSTREAM_OPENAI_FAILOVER_URL=
# UPSTREAM_ANTHROPIC_FAILOVER_URL=
# Optional Anthropic workspace id for org/multi-workspace API keys only (one-time; not daily).
# Prefer a workspace-scoped Anthropic key (then leave unset). Ids look like wrkspc_...
# Installed CLI users: set OS user env TRIM_ANTHROPIC_WORKSPACE_ID (Windows User env, or export in shell profile).
# Developers in this repo may set it here instead. Client anthropic-workspace-id header still wins.
# TRIM_ANTHROPIC_WORKSPACE_ID=
# Optional OpenAI org/project (client OpenAI-Organization / OpenAI-Project headers win).
# TRIM_OPENAI_ORGANIZATION=
# TRIM_OPENAI_PROJECT=
TRIM_API_BASE_URL=https://api.use-trim.com
APP_PUBLIC_URL=https://use-trim.com

# Must match server TRIM_CLI_HMAC_SECRET (openssl rand -hex 32)
TRIM_CLI_HMAC_SECRET=replace_with_long_random_hex

# Estimated USD saved per million trimmed tokens (dashboard / stats). Required; no silent default.
# Example: 3.0 means $3.00 per 1M tokens removed from the prompt.
TRIM_SAVINGS_USD_PER_MTOK=3.0

# Outbound HTTP timeouts (required; no invent 30/8/120/600/10).
# Local proxy upstream LLM timeout (seconds, 1-600).
TRIM_PROXY_HTTP_TIMEOUT_SEC=120
# Local proxy http.Server ReadHeaderTimeout (seconds, 1-120). No invent 10.
TRIM_HTTP_READ_HEADER_TIMEOUT_SEC=10
# CLI cloud API / chrome / TUI / telemetry timeout (seconds, 1-300).
TRIM_CLI_HTTP_TIMEOUT_SEC=30
# Deep Mode optimizer.py wall-clock kill (seconds, 1-3600). Local only; never on Render.
TRIM_DEEP_TIMEOUT_SEC=600
# Bubble Tea TUI poll interval (seconds, 1-60). REQUIRED. No invent 2.
TRIM_TUI_REFRESH_SEC=2
# SQLite series window for `trim stats` and proxy /v1/stats/series default (1-365). REQUIRED. No invent 14.
TRIM_STATS_SERIES_DAYS=14
# SQLite series window for Bubble Tea TUI (1-365). REQUIRED. No invent 7.
TRIM_TUI_SERIES_DAYS=7
# Local dashboard before/after preview max chars (32-100000). REQUIRED. No invent 1200.
TRIM_PROXY_PREVIEW_MAX_CHARS=1200
# TUI error string max chars (16-2000). REQUIRED. No invent 80.
TRIM_TUI_ERROR_MAX_CHARS=80

# Optional model routing (set both or neither)
# TRIM_CHEAP_MODEL=gpt-4o-mini
# TRIM_ROUTE_MAX_TOKENS=8000

# Fast Mode intensity when project has no .trimrc mode= (mild|balanced|aggressive|custom).
# Empty = pass-through. Prefer .trimrc mode=balanced in each repo (see .trimrc.example).
# TRIM_COMPRESSION_MODE=balanced

# Sliding-window chat history (optional). .trimrc history_keep_turns wins when set.
# TRIM_HISTORY_KEEP_TURNS=8

# When `trim setup` adds a Continue.dev model entry, set model id and title (no invent "Trim local").
# TRIM_SETUP_DEFAULT_MODEL=gpt-4o-mini
# TRIM_SETUP_DEFAULT_MODEL_TITLE=Trim local

# Optional TLS for https://localhost IDE overrides.
# For `trim setup --tls`, both org and validity days are required (no invent "Trim Local Proxy" / 365).
# TRIM_TLS_ORG=Trim Local Proxy
# TRIM_TLS_VALIDITY_DAYS=365
# TRIM_TLS_CERT=C:\Users\you\.config\trim\tls\cert.pem
# TRIM_TLS_KEY=C:\Users\you\.config\trim\tls\key.pem

# Deep Mode (local LLMLingua only; never set these on Render)
# TRIM_OPTIMIZER_PY=C:\path\to\optimizer.py
# TRIM_PYTHON=python3
# Machine-local device map only (cpu / cuda). Model ids + force_tokens + min tokens + OOM policy
# come from billing_settings via: trim config sync (no invent in CLI).
TRIM_DEEP_DEVICE_MAP=cpu

# Telemetry (optional). Opt out with either env var, or: trim telemetry disable
# DO_NOT_TRACK=1
# TRIM_TELEMETRY_DISABLED=1
