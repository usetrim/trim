# Trim API (cloud mode on Render)
# Copy to .env and fill every value. There are no silent defaults.
#
# PRICING IS NOT IN THIS FILE.
# Edit Supabase tables instead:
#   public.plan_catalog          (display cents, credits, paddle_price_id_monthly/yearly/topup)
#   public.billing_settings      (annual_discount_percent, apply_paddle_discount_on_annual,
#                                 paddle_discount_id, paddle_discount_code, allow_downgrades,
#                                 upgrade_proration_mode)
# allow_downgrades should stay false for self-serve (upgrades only).

DEPLOYMENT_MODE=cloud
PORT=8080
# Optional ops label for multi-region logs (see docker-compose.multi-region.example.yml).
# Not used for quota math. Leave empty on single-region Render.
# TRIM_REGION_LABEL=us-east

# Postgres (Supabase connection string, require SSL in production)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Upstash Redis (rediss:// for TLS)
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_ENDPOINT.upstash.io:6379

JWT_SECRET=your-supabase-jwt-secret
# Legacy HS256 only: Project Settings → API → JWT Secret (Legacy).
# Modern Supabase projects sign access tokens with ES256; the API verifies those
# via SUPABASE_URL/auth/v1/.well-known/jwks.json (kid + P-256). Keep JWT_SECRET
# set for older HS256 tokens / local fixtures.

# Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paddle Billing (secrets only; prices and discounts are DB rows)
# PADDLE_API_KEY is required for:
#   - in-place upgrades (PATCH /subscriptions with proration)
#   - upgrade preview (POST preview before confirm=true charge)
#   - invoice PDF URLs on receipts (GET /transactions/{id}/invoice?disposition=inline)
#   - receipt backfill (GET /transactions?customer_id=&status=completed via POST /billing/receipts/sync)
# Portal cancel_url is omitted when billing_settings.allow_downgrades=false.
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_...
PADDLE_WEBHOOK_SECRET=pdl_ntfsec_...
# Outbound Paddle Billing HTTP timeout (seconds). REQUIRED in cloud. No invent 30.
PADDLE_HTTP_TIMEOUT_SEC=30
# Receipt sync list pagination. REQUIRED in cloud. No invent maxPages=100 / per_page=50.
PADDLE_LIST_MAX_PAGES=100
PADDLE_LIST_PER_PAGE=50
# Cloud/self proxy upstream LLM HTTP timeout (seconds). REQUIRED. No invent 120 / infinite.
TRIM_PROXY_HTTP_TIMEOUT_SEC=120
# http.Server ReadHeaderTimeout (seconds). REQUIRED cloud+self. No invent 10.
TRIM_HTTP_READ_HEADER_TIMEOUT_SEC=10
# Graceful Shutdown context timeout (seconds). REQUIRED cloud+self. No invent 10.
TRIM_HTTP_SHUTDOWN_TIMEOUT_SEC=10
# Async Redis→Postgres quota sync budget (seconds). REQUIRED cloud+self. No invent 5.
TRIM_QUOTA_SYNC_TIMEOUT_SEC=5
# Async trim_events insert budget (seconds). REQUIRED cloud+self. No invent 5.
TRIM_EVENT_INSERT_TIMEOUT_SEC=5
# Durable outbox wake channel depth + worker count. REQUIRED. No invent 1000 / 3.
TRIM_EVENT_INSERT_QUEUE_SIZE=1000
TRIM_EVENT_INSERT_WORKERS=3
# Periodic outbox drain so dropped wake signals cannot starve (required; no invent).
TRIM_EVENT_OUTBOX_POLL_SEC=5
# SKIP LOCKED claim batch size per drain (required; no invent 32).
TRIM_EVENT_OUTBOX_BATCH=32
# Paddle Redis list max depth + BRPOP workers. REQUIRED. No invent 1000 / 3.
TRIM_WEBHOOK_QUEUE_SIZE=1000
TRIM_WEBHOOK_WORKERS=3
# Paddle webhook worker process budget (seconds). REQUIRED in cloud. No invent 20.
TRIM_WEBHOOK_PROCESS_TIMEOUT_SEC=20
# Docker/CLI -readyz probe budget (seconds). REQUIRED. No invent 5.
TRIM_READYZ_TIMEOUT_SEC=5
# CORS Access-Control-Max-Age (seconds). REQUIRED. No invent 300.
TRIM_CORS_MAX_AGE_SEC=300
# Periodic site_messages cache reload (seconds) so missed pub/sub cannot starve. REQUIRED. No invent.
TRIM_SITE_MESSAGES_RELOAD_SEC=60
# pgx write-pool sizing. REQUIRED. No invent driver defaults.
TRIM_PG_MAX_CONNS=20
TRIM_PG_MIN_CONNS=2
# Optional Postgres read replica / pooler URL. Empty = all reads on DATABASE_URL.
# When set, TRIM_PG_READ_MAX_CONNS / TRIM_PG_READ_MIN_CONNS are required (no invent).
# DATABASE_READ_URL=postgres://...
# TRIM_PG_READ_MAX_CONNS=20
# TRIM_PG_READ_MIN_CONNS=2
# Outbound enterprise sales webhook timeout (seconds). Required when ENTERPRISE_NOTIFY_WEBHOOK_URL is set. No invent 8.
# TRIM_ENTERPRISE_NOTIFY_TIMEOUT_SEC=8

# Redis key TTLs (seconds). REQUIRED in cloud. No invent 70s / 1h / 24h / 30d.
TRIM_REDIS_TTL_VELOCITY_SEC=70
TRIM_REDIS_TTL_API_KEY_SEC=3600
TRIM_REDIS_TTL_AUTH_PROVIDERS_SEC=60
TRIM_REDIS_TTL_QUOTA_SEC=86400
TRIM_REDIS_TTL_HARDWARE_GRAPH_SEC=2592000
TRIM_REDIS_TTL_IP_BLOCK_SEC=2592000
TRIM_REDIS_TTL_JA4_SEEN_SEC=604800
TRIM_REDIS_TTL_IP_RISK_SEC=86400
TRIM_REDIS_TTL_ASN_CHECKED_SEC=86400
TRIM_REDIS_TTL_ASN_MISS_SEC=21600
TRIM_REDIS_TTL_TELEMETRY_SEC=86400
# Dashboard chart JSON cache TTL is DB-only: billing_settings.chart_cache_ttl_sec
# (admin PATCH /admin/billing/settings). No invent env TTL.
# Default row cap for POST /internal/expire-subscriptions (required in cloud; query ?limit= may override up to 2000). No invent 200.
TRIM_EXPIRE_BATCH_DEFAULT_LIMIT=200

# Upstream LLM providers the proxy forwards to
UPSTREAM_OPENAI_URL=https://api.openai.com
UPSTREAM_ANTHROPIC_URL=https://api.anthropic.com
# Optional same-shape failover (Azure OpenAI, secondary gateway, vLLM). Empty disables.
# UPSTREAM_OPENAI_FAILOVER_URL=https://your-azure-openai.openai.azure.com
# UPSTREAM_ANTHROPIC_FAILOVER_URL=https://api.anthropic.com

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://use-trim.com,https://www.use-trim.com,https://admin.use-trim.com

# Required in DEPLOYMENT_MODE=cloud. Browser Origin allow-list for /api/v1/admin/* only.
# Self-host: optional; when set, admin API refuses mismatched Origin.
ADMIN_ALLOWED_ORIGINS=http://localhost:3001,https://admin.use-trim.com
# Optional admin client IP allow-list (CIDRs). Empty = no IP lock.
# ADMIN_ALLOWED_CIDRS=203.0.113.0/24
# 32-byte AES key (64 hex) for platform admin TOTP secret encryption.
# TRIM_ADMIN_TOTP_KEY=
# Optional Cloudflare Access JWT gate on /api/v1/admin/*. Both required together, or both empty.
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=your-application-audience-uuid

# Platform operator console (apps/admin). Comma-separated emails promoted to owner role on boot.
# TRIM_PLATFORM_OWNER_EMAILS=you@example.com
# Required before step-up works (seconds, 60-43200). Empty = step-up fails closed.
# TRIM_ADMIN_STEP_UP_TTL_SEC=43200
# Optional GitHub distribution sync (clones + release downloads).
# TRIM_GITHUB_TOKEN=
# TRIM_GITHUB_REPO=owner/repo
# Optional package-manager / Marketplace channels (reuse TRIM_GITHUB_TOKEN for tap traffic).
# TRIM_DIST_HOMEBREW_TAP_REPO=usetrim/homebrew-tap
# TRIM_DIST_SCOOP_BUCKET_REPO=usetrim/scoop-trim
# TRIM_DIST_WINGET_FORK_REPO=usetrim/winget-pkgs
# TRIM_DIST_VSCODE_EXTENSION_ID=usetrim.trim-ide

MIN_CLI_VERSION=0.1.0
APP_PUBLIC_URL=https://use-trim.com

# Shown on in-app receipts (seller letterhead)
COMPANY_LEGAL_NAME=Trim
COMPANY_SUPPORT_EMAIL=support@use-trim.com
# Optional HTTPS logo for receipt letterhead (Cloudinary or static CDN).
# COMPANY_LOGO_URL=https://res.cloudinary.com/your_cloud/image/upload/v1/trim-logo.png
# Optional seller address / tax IDs for global receipt letterhead.
# COMPANY_ADDRESS_LINE1=123 Market Street
# COMPANY_ADDRESS_LINE2=Suite 400
# COMPANY_CITY=San Francisco
# COMPANY_REGION=CA
# COMPANY_POSTAL_CODE=94105
# COMPANY_COUNTRY=United States
# COMPANY_VAT_ID=VAT GB123456789
# COMPANY_REGISTRATION=Company No. 12345678

# Shared secret for TrimCLI request HMAC (X-Trim-Signature). Must match CLI TRIM_CLI_HMAC_SECRET.
# Generate with: openssl rand -hex 32
TRIM_CLI_HMAC_SECRET=replace_with_long_random_hex

# Estimated USD saved per million trimmed tokens (proxy /metrics and /v1/stats). Required.
TRIM_SAVINGS_USD_PER_MTOK=3.0

# Free-tier Hashcash difficulty for TrimCLI metered requests (SHA-256 leading zero bits).
# REQUIRED in cloud (0-24). Set 0 to disable. No silent invent.
TRIM_POW_DIFFICULTY=16

# Honeypot API key prefix. Presenting a key with this prefix bans IP + hardware.
# Embed a canary key in public docs only if you rotate and monitor it.
# TRIM_CANARY_API_KEY_PREFIX=sk_canary_

# Optional model routing (empty disables). When prompt token estimate <= TRIM_ROUTE_MAX_TOKENS,
# rewrite request model to TRIM_CHEAP_MODEL. Set both or neither.
# TRIM_CHEAP_MODEL=gpt-4o-mini
# TRIM_ROUTE_MAX_TOKENS=8000

# Optional: seed Redis key ip_risk:proxy:<ip>=true to block VPN/proxy IPs on free tier.
# Optional: seed Redis key hw_block:<hardware_uuid>=true to ban a device.
# Optional: seed Redis key ja4_block:<fingerprint>=true when edge forwards CF-JA4 / X-JA4.
# Behind Cloudflare, Trim also reads CF-Connecting-IP, CF-Threat-Score, CF-IPCountry (T1=Tor),
# CF-JA4, and CF-ASN. Transform Rules can forward visitor ASN as CF-ASN. Auto ASN/VPN hosting
# enrichment uses the free ipwho.is lookup and caches results in Redis for 24h.

# Optional: Docker Tree-sitter build (Render Docker or local compose).
# ENABLE_TREESITTER=1 docker compose build api
# Default remains CGO-free heuristics + Go stdlib AST.

# Auth providers (comma-separated). REQUIRED in cloud mode (fail closed; no silent default).
# Must match NEXT_PUBLIC_ALLOWED_AUTH_PROVIDERS on the web app.
# On API boot, values are upserted into public.auth_settings (signup trigger reads DB).
# Enable the same three providers in Supabase Auth. Scopes are DB chrome:
# AUTH_GITHUB_OAUTH_SCOPES=read:user user:email, AUTH_GITLAB_OAUTH_SCOPES=read_user.
# Enable Supabase Automatic linking for the same verified email across providers.
# Settings Connect / Disconnect reads auth.identities via public.list_auth_identities
# (migration 46). No extra env keys for linking.
ALLOWED_AUTH_PROVIDERS=google,github,gitlab

# Cloud proxy compression intensity (required in cloud). mild|balanced|aggressive|custom
# Empty = pass-through (no silent invent of balanced). Local CLI: .trimrc mode= wins,
# else TRIM_COMPRESSION_MODE from env, else pass-through.
TRIM_COMPRESSION_MODE=balanced

# Sliding-window chat history: keep last N non-system turns; older turns stubbed.
# 0 or unset = disabled (no invent default). Prefer .trimrc history_keep_turns locally.
# TRIM_HISTORY_KEEP_TURNS=8

# Optional offline IP risk (prefer over live ipwho.is when set).
# Raw MaxMind GeoLite2 .mmdb is supported (Anonymous-IP and/or ASN).
# Or point at a plain text ASN/CIDR list (see server/config/hosting-asns.example.txt).
# There is no hardcoded hosting ASN invent map in Go; mount your list here.
# TRIM_GEOLITE_ASN_MMDB_PATH=/etc/trim/hosting-asns.txt
# TRIM_GEOLITE_ANONYMOUS_MMDB_PATH=/etc/trim/GeoLite2-Anonymous-IP.mmdb

# Fraud / anti-abuse thresholds (REQUIRED in cloud; no invent floors).
TRIM_MAX_ACCOUNTS_PER_HARDWARE=3
TRIM_MAX_ACCOUNTS_PER_JA4=5
# REQUIRED in cloud: block when Cloudflare CF-Threat-Score >= this value (1-100).
TRIM_CF_THREAT_SCORE_MIN=50
TRIM_CLI_TIMESTAMP_SKEW_SEC=30
TRIM_RATE_LIMIT_IP_PER_MIN=120
TRIM_RATE_LIMIT_USER_PER_MIN=60
TRIM_IP_RISK_LOOKUP_TIMEOUT_MS=2000

# Optional cron: POST /internal/expire-subscriptions with header X-Cron-Secret: <value>
# Hit hourly from cron-job.org or Render cron so idle expired subs drop to free.
# Leave empty to disable the route (per-request ExpireIfNeeded still runs).
# CRON_SECRET protects POST /internal/expire-subscriptions (idle period_end -> free)
# and POST /internal/retention-purge (trim_events partition DROP + leftover DELETE + admin_audit_log TTL).
# Retention also ensures future trim_events month partitions from
# admin_retention_settings.trim_events_partition_months_ahead and
# trim_events_partition_ensure_sec (DB-only; no invent env).
# Also set GitHub Actions secrets TRIM_API_BASE_URL + CRON_SECRET for
# .github/workflows/expire-subscriptions.yml and retention-purge.yml.
# Unauthenticated requests fail closed.
# CRON_SECRET=replace_with_long_random_hex

# Optional: HTTPS webhook (Slack Incoming Webhook, Discord, or your ops inbox)
# fired asynchronously after POST /api/v1/plans/enterprise-inquiry succeeds.
# Leave empty to skip notify (inquiry is still stored in enterprise_inquiries).
# ENTERPRISE_NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional Cloudinary avatar re-host (POST /api/v1/me/avatar/sync).
# Leave unset to skip; OAuth avatar_url from Supabase Auth still works.
# When CLOUDINARY_CLOUD_NAME is set, CLOUDINARY_HTTP_TIMEOUT_SEC is REQUIRED (1-300).
# CLOUDINARY_CLOUD_NAME=your_cloud
# CLOUDINARY_HTTP_TIMEOUT_SEC=30
# CLOUDINARY_UPLOAD_PRESET=trim_avatars
# Or signed upload:
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...

# Optional SMTP for workspace invite emails (all of HOST, PORT, FROM required to send).
# Invite always returns invite_url; email is best-effort when SMTP is set.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_...
# SMTP_FROM=Trim <invites@use-trim.com>

# After supabase db push, bind real Paddle price IDs (not in this file):
#   psql "$DATABASE_URL" -f scripts/bind-paddle-prices.sql
#   (replace pri_REPLACE_* placeholders first)
# Top-up packs use billing_topup_ledger (unique per transaction+price) so webhook retries never double-credit.
# Deep Mode default target tokens: edit billing_settings.default_deep_target_token (not env).
# Team seats: subscriptions.seat_quantity is set from Paddle item quantity; new workspaces inherit it.